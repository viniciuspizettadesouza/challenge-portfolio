{
  "name": "challenge-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter portfolio dev",
    "build": "pnpm --filter portfolio build",
    "preview": "pnpm --filter portfolio preview",
    "lint": "pnpm --filter portfolio lint",
    "typecheck": "pnpm --filter portfolio typecheck",
    "test": "pnpm --filter portfolio test",
    "test:e2e": "pnpm --filter portfolio test:e2e",
    "screenshots": "pnpm --filter portfolio screenshots",
    "verify:migration": "node scripts/migration/verify-imports.mjs",
    "inventory": "node scripts/migration/generate-inventory.mjs && node scripts/migration/sync-challenge-metadata.mjs",
    "migration:check": "node scripts/migration/check-environment.mjs",
    "migration:backup": "node scripts/migration/backup-repositories.mjs",
    "migration:metadata": "node scripts/migration/export-github-metadata.mjs",
    "migration:import": "node scripts/migration/import-history.mjs",
    "migration:refresh": "node scripts/migration/refresh-import-metadata.mjs"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vue": "3.5.40"
  }
}
