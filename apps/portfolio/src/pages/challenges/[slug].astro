---
import type { GetStaticPaths } from "astro";
import ChallengeDemo from "../../components/ChallengeDemo.astro";
import LegacyRedirect from "../../components/LegacyRedirect.astro";
import { challenges, type Challenge } from "../../challenges/registry";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";

export const getStaticPaths = (() => [
  ...challenges.map((challenge) => ({
    params: { slug: challenge.slug },
    props: { challenge },
  })),
  ...challenges.flatMap((challenge) =>
    challenge.aliases.map((alias) => ({
      params: { slug: alias },
      props: { redirectTo: challenge },
    })),
  ),
]) satisfies GetStaticPaths;

interface Props {
  challenge?: Challenge;
  redirectTo?: Challenge;
}

const { challenge, redirectTo } = Astro.props;
---

{
  redirectTo ? (
    <LegacyRedirect
      destination={withBase(`challenges/${redirectTo.slug}`)}
      title={redirectTo.title}
    />
  ) : challenge ? (
    <BaseLayout title={`${challenge.title} — Challenge Portfolio`}>
      <article>
        <header class="challenge-hero">
          <a class="back-link" href={withBase("challenges")}>
            ← All challenges
          </a>
          <div class="challenge-title">
            <div>
              <p class="eyebrow">{challenge.themes.join(" · ")}</p>
              <h1>{challenge.title}</h1>
            </div>
            <span
              class:list={["status", `status--${challenge.migrationStatus}`]}
            >
              {challenge.migrationStatus}
            </span>
          </div>
          <p class="hero__copy">{challenge.description}</p>
        </header>

        <div class="detail-grid">
          <section class="panel panel--demo">
            <p class="eyebrow">Presentation</p>
            <h2>
              {challenge.demoPath ? "Interactive demo" : "Demo in preparation"}
            </h2>
            <ChallengeDemo slug={challenge.slug} />
          </section>

          <aside class="panel panel--meta">
            <dl>
              <div>
                <>
                  <dt>Status</dt>
                  <dd>{challenge.migrationStatus}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>Strategy</dt>
                  <dd>{challenge.migrationStrategy}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>Themes</dt>
                  <dd>{challenge.themes.join(", ")}</dd>
                </>
              </div>
            </dl>
            <h3>Preserved sources</h3>
            <ul class="source-list">
              {challenge.sources.map((source) => (
                <li>
                  <strong>{source.title}</strong>
                  <span>
                    {source.originalRepository} · {source.originalDefaultBranch}{" "}
                    · {source.originalHeadSha.slice(0, 7)}
                  </span>
                  <a
                    href={`https://github.com/viniciuspizettadesouza/challenge-portfolio/tree/main/${source.sourcePath}`}
                  >
                    View preserved source
                  </a>
                </li>
              ))}
            </ul>
            <div class="meta-actions">
              {challenge.demoPath && (
                <a class="button" href={withBase(`demos/${challenge.slug}`)}>
                  Open fullscreen demo
                </a>
              )}
            </div>
          </aside>
        </div>
      </article>
    </BaseLayout>
  ) : null
}
