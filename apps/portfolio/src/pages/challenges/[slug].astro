---
import type { GetStaticPaths } from "astro";
import ChallengeDemo from "../../components/ChallengeDemo.astro";
import { challenges, type Challenge } from "../../challenges/registry";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";

export const getStaticPaths = (() =>
  challenges.map((challenge) => ({
    params: { slug: challenge.slug },
    props: { challenge },
  }))) satisfies GetStaticPaths;

interface Props {
  challenge: Challenge;
}

const { challenge } = Astro.props;
const sourceUrl = `https://github.com/viniciuspizettadesouza/challenge-portfolio/tree/main/${challenge.sourcePath}`;
---

<BaseLayout title={`${challenge.title} — Challenge Portfolio`}>
  <article>
    <header class="challenge-hero">
      <a class="back-link" href={withBase("challenges")}>← All challenges</a>
      <div class="challenge-title">
        <div>
          <p class="eyebrow">{challenge.company}</p>
          <h1>{challenge.title}</h1>
        </div>
        <span class:list={["status", `status--${challenge.migrationStatus}`]}>
          {challenge.migrationStatus}
        </span>
      </div>
      <p class="hero__copy">{challenge.description}</p>
    </header>

    <div class="detail-grid">
      <section class="panel panel--demo">
        <p class="eyebrow">Presentation</p>
        <h2>
          {challenge.demoPath ? "Interactive demo" : "Demo in preparation"}
        </h2>
        <ChallengeDemo slug={challenge.slug} />
      </section>

      <aside class="panel panel--meta">
        <dl>
          <div><dt>Status</dt><dd>{challenge.migrationStatus}</dd></div>
          <div><dt>Strategy</dt><dd>{challenge.migrationStrategy}</dd></div>
          <div><dt>Original branch</dt><dd>{challenge.originalDefaultBranch}</dd></div>
          <div>
            <dt>Original repository</dt>
            <dd>{challenge.originalRepository}</dd>
          </div>
          <div>
            <dt>Original SHA</dt>
            <dd>{challenge.originalHeadSha || "Awaiting import"}</dd>
          </div>
        </dl>
        <div class="meta-actions">
          {
            challenge.demoPath && (
              <a class="button" href={withBase(`demos/${challenge.slug}`)}>
                Open fullscreen demo
              </a>
            )
          }
          <a class="button button--secondary" href={sourceUrl}>View preserved source</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
