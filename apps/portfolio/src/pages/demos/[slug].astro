---
import type { GetStaticPaths } from "astro";
import { challenges, type Challenge } from "../../challenges/registry";
import DemoPage from "../../components/DemoPage.astro";
import LegacyRedirect from "../../components/LegacyRedirect.astro";
import { withBase } from "../../lib/urls";

export const getStaticPaths = (() => [
  ...challenges
    .filter(({ demoPath }) => demoPath)
    .map((challenge) => ({
      params: { slug: challenge.slug },
      props: { challenge },
    })),
  ...challenges.flatMap((challenge) =>
    challenge.aliases.map((alias) => ({
      params: { slug: alias },
      props: { redirectTo: challenge },
    })),
  ),
]) satisfies GetStaticPaths;

interface Props {
  challenge?: Challenge;
  redirectTo?: Challenge;
}
const { challenge, redirectTo } = Astro.props;
---

{
  redirectTo ? (
    <LegacyRedirect
      destination={withBase(`demos/${redirectTo.slug}`)}
      title={`${redirectTo.title} Demo`}
    />
  ) : challenge ? (
    <DemoPage challenge={challenge} />
  ) : null
}
