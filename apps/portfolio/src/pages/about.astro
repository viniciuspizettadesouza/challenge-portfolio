---
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "Learn how the Challenge Portfolio preserves historical source code while presenting secure, accessible, and maintainable modern demos.";
---

<BaseLayout title="About — Challenge Portfolio" {description}>
  <section class="page-intro prose">
    <p class="eyebrow">About the archive</p>
    <h1>Preserve before modernizing.</h1>
    <p>
      This portfolio brings together technical challenges created across
      different eras, frameworks, and contexts. Consolidation keeps historical
      source separate from every executable adaptation.
    </p>
    <p>
      Source trees, commit messages, and dates are verified before a project is
      considered migrated. When running old software is unsafe or impractical,
      its page becomes a documented case study instead.
    </p>
  </section>
</BaseLayout>
