---
import ChallengeCard from "../components/ChallengeCard.astro";
import { challenges } from "../challenges/registry";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
---

<BaseLayout title="Challenge Portfolio">
  <section class="hero">
    <p class="eyebrow">A living work archive</p>
    <h1>{challenges.length} challenges.<br />One navigable history.</h1>
    <p class="hero__copy">
      Original source and technical decisions preserved, with adapted demos
      designed to keep working on the modern web.
    </p>
    <a class="button" href={withBase("challenges")}>Explore the challenges</a>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Catalog</p>
        <h2>First in line</h2>
      </div>
      <a href={withBase("challenges")}>View all ({challenges.length})</a>
    </div>
    <div class="grid">
      {challenges.slice(0, 6).map((challenge) => <ChallengeCard challenge={challenge} />)}
    </div>
  </section>
</BaseLayout>
