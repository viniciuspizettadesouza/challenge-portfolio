---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Historical technical challenges preserved and presented in one portfolio.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">Challenge Portfolio</a>
      <nav aria-label="Main navigation">
        <a href="/challenges">Challenges</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer>
      <p>Historical source preserved. Demos adapted without changing originals.</p>
    </footer>
  </body>
</html>
