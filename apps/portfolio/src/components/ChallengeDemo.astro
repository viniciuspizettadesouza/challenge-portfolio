---
import ConazDemo from "@challenge/conaz-demo";
import DevlandiaDemo from "@challenge/devlandia-demo";
import SalsifyDemo from "@challenge/salsify-demo";
import VueDemo from "@challenge/vue-demo";
import ZygoDemo from "@challenge/zygo-demo";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{
  slug === "challenge-salsify" ? (
    <SalsifyDemo client:load />
  ) : slug === "challenge-vue" ? (
    <VueDemo client:load />
  ) : slug === "challenge-conaz" ? (
    <ConazDemo />
  ) : slug === "challenge-zygo" ? (
    <ZygoDemo />
  ) : slug === "challenge-devlandia" ? (
    <DevlandiaDemo />
  ) : (
    <div class="demo-placeholder">
      <p>The demo will be defined after this challenge's manual review.</p>
    </div>
  )
}
