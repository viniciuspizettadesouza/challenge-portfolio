---
import { getChallenge } from "../challenges/registry";
import ReactDemoHost from "./demos/ReactDemoHost";
import StaticDemoHost from "./demos/StaticDemoHost.astro";
import VueDemoHost from "./demos/VueDemoHost.vue";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const challenge = getChallenge(slug);
---

{
  challenge?.renderer === "react" ? (
    <ReactDemoHost slug={slug} client:load />
  ) : challenge?.renderer === "vue3" ? (
    <VueDemoHost slug={slug} client:load />
  ) : challenge?.renderer === "static" ? (
    <StaticDemoHost slug={slug} />
  ) : (
    <div class="demo-placeholder">
      <p>No maintained demo is registered for this entry.</p>
    </div>
  )
}
