---
import ConazDemo from "@challenge/conaz-demo";
import DevlandiaDemo from "@challenge/devlandia-demo";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{
  slug === "javascript-data-exercises" ? (
    <ConazDemo />
  ) : slug === "grid-pathfinding" ? (
    <DevlandiaDemo />
  ) : null
}
