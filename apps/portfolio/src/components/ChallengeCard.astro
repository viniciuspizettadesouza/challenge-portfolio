---
import type { Challenge } from "../challenges/registry";

interface Props {
  challenge: Challenge;
}

const { challenge } = Astro.props;
---

<article class="card">
  <div class="card__eyebrow">
    <span>{challenge.company}</span>
    <span class:list={["status", `status--${challenge.migrationStatus}`]}>
      {challenge.migrationStatus}
    </span>
  </div>
  <h2><a href={`/challenges/${challenge.slug}`}>{challenge.title}</a></h2>
  <p>{challenge.description}</p>
  <span class="card__link" aria-hidden="true">Ver challenge →</span>
</article>

