---
import {
  convertToRoman,
  countCharacters,
  fullPath,
  nextMove,
  runLengthEncode,
  updateMembers,
} from "./logic";

const sampleGrid = `-----
-----
p--m-
-----
-----`;
const initialMembers = [
  { number: 1, active: true, ticket: 10 },
  { number: 2, active: false, ticket: 0 },
  { number: 3, active: true, ticket: 12 },
  { number: 4, active: false, ticket: 0 },
  { number: 5, active: true, ticket: 14 },
  { number: 6, active: true, ticket: 15 },
];
const incomingMembers = [
  { number: 1, ticket: 16 },
  { number: 3, ticket: 13 },
  { number: 5, ticket: 15 },
  { number: 8, ticket: 10 },
  { number: 9, ticket: 19 },
];
---

<algorithm-playground>
  <header class="playground-hero">
    <div>
      <p class="eyebrow">Three historical challenges · one interactive workspace</p>
      <h2>Algorithm Playground</h2>
      <p>
        Explore text transformations, record synchronisation, numeral conversion,
        and grid navigation without external services.
      </p>
    </div>
    <div class="hero-stats" aria-label="Playground summary">
      <strong>6</strong><span>algorithms</span>
      <strong>3</strong><span>source projects</span>
    </div>
  </header>

  <nav class="lab-tabs" role="tablist" aria-label="Algorithm laboratories">
    <button type="button" role="tab" id="tab-text" aria-controls="panel-text" aria-selected="true" data-lab="text">
      <span>01</span> Text lab
    </button>
    <button type="button" role="tab" id="tab-members" aria-controls="panel-members" aria-selected="false" tabindex="-1" data-lab="members">
      <span>02</span> Member sync
    </button>
    <button type="button" role="tab" id="tab-roman" aria-controls="panel-roman" aria-selected="false" tabindex="-1" data-lab="roman">
      <span>03</span> Roman numerals
    </button>
    <button type="button" role="tab" id="tab-path" aria-controls="panel-path" aria-selected="false" tabindex="-1" data-lab="path">
      <span>04</span> Grid path
    </button>
  </nav>

  <main>
    <section id="panel-text" role="tabpanel" aria-labelledby="tab-text" data-panel="text">
      <div class="lab-heading">
        <p>Conaz · string processing</p>
        <h3>Inspect and compress text</h3>
        <span>Both results update while you type.</span>
      </div>
      <div class="tool-grid">
        <article>
          <label for="algorithm-frequency">Character frequency</label>
          <input id="algorithm-frequency" value="teste conaz" />
          <output id="algorithm-frequency-output">{JSON.stringify(countCharacters("teste conaz"), null, 2)}</output>
        </article>
        <article>
          <label for="algorithm-encoding">Run-length encoding</label>
          <input id="algorithm-encoding" value="aaaaabbbbccccccaaaaaaa" />
          <output id="algorithm-encoding-output">{runLengthEncode("aaaaabbbbccccccaaaaaaa")}</output>
        </article>
      </div>
    </section>

    <section id="panel-members" role="tabpanel" aria-labelledby="tab-members" data-panel="members" hidden>
      <div class="lab-heading">
        <p>Conaz · collection reconciliation</p>
        <h3>Synchronise monthly members</h3>
        <span>Update matching tickets, deactivate missing records, and append new arrivals.</span>
      </div>
      <div class="member-layout">
        <div class="member-flow" aria-label="Synchronisation steps">
          <span>6 current</span><b>+</b><span>5 incoming</span><b>→</b><span>8 reconciled</span>
        </div>
        <button class="primary-action" type="button" id="algorithm-update-members">Run synchronisation</button>
        <output id="algorithm-members-output">Ready to reconcile the two preserved fixtures.</output>
      </div>
    </section>

    <section id="panel-roman" role="tabpanel" aria-labelledby="tab-roman" data-panel="roman" hidden>
      <div class="lab-heading">
        <p>PropertiaG · greedy conversion</p>
        <h3>Translate an integer</h3>
        <span>Enter a whole number in the original challenge range, from 1 to 1,000.</span>
      </div>
      <div class="roman-layout">
        <div>
          <label for="algorithm-roman">Number</label>
          <input id="algorithm-roman" type="number" min="1" max="1000" step="1" value="42" />
          <div class="examples" aria-label="Example values">
            {[4, 9, 42, 944, 1000].map((value) => <button type="button" data-roman-value={value}>{value}</button>)}
          </div>
        </div>
        <output id="algorithm-roman-output" aria-live="polite"><span>Roman numeral</span><strong>{convertToRoman(42)}</strong></output>
      </div>
    </section>

    <section id="panel-path" role="tabpanel" aria-labelledby="tab-path" data-panel="path" hidden>
      <div class="lab-heading">
        <p>Devlandia · Ruby logic adapted to TypeScript</p>
        <h3>Guide the bot across a square grid</h3>
        <span>Use <code>m</code> for the bot and <code>p</code> for the princess.</span>
      </div>
      <div class="path-layout">
        <div>
          <label for="algorithm-grid">Editable grid</label>
          <textarea id="algorithm-grid" rows="5" spellcheck="false">{sampleGrid}</textarea>
          <div class="path-actions">
            <button class="primary-action" type="button" id="algorithm-full-path">Show full path</button>
            <button type="button" id="algorithm-next-move">Show next move</button>
          </div>
        </div>
        <output id="algorithm-path-output">{`Full path:\n${fullPath(sampleGrid).join("\n")}\n\nNext move:\n${nextMove(sampleGrid)}`}</output>
      </div>
    </section>
  </main>
</algorithm-playground>

<script>
  import {
    convertToRoman,
    countCharacters,
    fullPath,
    nextMove,
    runLengthEncode,
    updateMembers,
  } from "./logic";

  const initialMembers = [
    { number: 1, active: true, ticket: 10 },
    { number: 2, active: false, ticket: 0 },
    { number: 3, active: true, ticket: 12 },
    { number: 4, active: false, ticket: 0 },
    { number: 5, active: true, ticket: 14 },
    { number: 6, active: true, ticket: 15 },
  ];
  const incomingMembers = [
    { number: 1, ticket: 16 },
    { number: 3, ticket: 13 },
    { number: 5, ticket: 15 },
    { number: 8, ticket: 10 },
    { number: 9, ticket: 19 },
  ];

  class AlgorithmPlayground extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>("[role='tab']")];
      const panels = [...this.querySelectorAll<HTMLElement>("[role='tabpanel']")];
      const selectLab = (lab: string, focus = false) => {
        tabs.forEach((tab) => {
          const selected = tab.dataset.lab === lab;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focus) tab.focus();
        });
        panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== lab; });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectLab(tab.dataset.lab ?? "text"));
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          const offset = event.key === "ArrowRight" ? 1 : -1;
          const next = tabs[(index + offset + tabs.length) % tabs.length];
          selectLab(next.dataset.lab ?? "text", true);
        });
      });

      const frequency = this.querySelector<HTMLInputElement>("#algorithm-frequency");
      const frequencyOutput = this.querySelector<HTMLOutputElement>("#algorithm-frequency-output");
      frequency?.addEventListener("input", () => {
        if (frequencyOutput) frequencyOutput.textContent = JSON.stringify(countCharacters(frequency.value), null, 2);
      });

      const encoding = this.querySelector<HTMLInputElement>("#algorithm-encoding");
      const encodingOutput = this.querySelector<HTMLOutputElement>("#algorithm-encoding-output");
      encoding?.addEventListener("input", () => {
        if (encodingOutput) encodingOutput.textContent = runLengthEncode(encoding.value);
      });

      this.querySelector("#algorithm-update-members")?.addEventListener("click", () => {
        const output = this.querySelector<HTMLOutputElement>("#algorithm-members-output");
        if (output) output.textContent = JSON.stringify(updateMembers(initialMembers, incomingMembers), null, 2);
      });

      const romanInput = this.querySelector<HTMLInputElement>("#algorithm-roman");
      const romanOutput = this.querySelector<HTMLOutputElement>("#algorithm-roman-output");
      const renderRoman = () => {
        if (!romanInput || !romanOutput) return;
        const value = Number(romanInput.value);
        try {
          romanOutput.innerHTML = `<span>Roman numeral</span><strong>${convertToRoman(value)}</strong>`;
        } catch (error) {
          romanOutput.innerHTML = `<span>Validation</span><strong>${error instanceof Error ? error.message : "Invalid number."}</strong>`;
        }
      };
      romanInput?.addEventListener("input", renderRoman);
      this.querySelectorAll<HTMLButtonElement>("[data-roman-value]").forEach((button) => {
        button.addEventListener("click", () => {
          if (romanInput) romanInput.value = button.dataset.romanValue ?? "42";
          renderRoman();
        });
      });

      const grid = this.querySelector<HTMLTextAreaElement>("#algorithm-grid");
      const pathOutput = this.querySelector<HTMLOutputElement>("#algorithm-path-output");
      const runPath = (mode: "full" | "next") => {
        if (!grid || !pathOutput) return;
        try {
          const result = mode === "full" ? fullPath(grid.value).join("\n") : (nextMove(grid.value) ?? "DONE");
          pathOutput.textContent = mode === "full" ? `Full path:\n${result}` : `Next move:\n${result}`;
        } catch (error) {
          pathOutput.textContent = error instanceof Error ? error.message : "Invalid grid.";
        }
      };
      this.querySelector("#algorithm-full-path")?.addEventListener("click", () => runPath("full"));
      this.querySelector("#algorithm-next-move")?.addEventListener("click", () => runPath("next"));
    }
  }

  if (!customElements.get("algorithm-playground")) {
    customElements.define("algorithm-playground", AlgorithmPlayground);
  }
</script>

<style>
  algorithm-playground { display: block; min-height: 42rem; overflow: hidden; color: #17211c; background: #f2f4ee; border-radius: .85rem; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .playground-hero { display: flex; justify-content: space-between; gap: 2rem; padding: clamp(1.5rem, 4vw, 3.2rem); color: #f7faef; background: radial-gradient(circle at 88% 18%, rgb(184 243 74 / 24%), transparent 18rem), linear-gradient(135deg, #10291f, #0b1713); }
  .eyebrow, .lab-heading > p { margin: 0 0 .65rem; color: #b8f34a; font-size: .68rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .playground-hero h2 { margin: 0; font-size: clamp(2.1rem, 5vw, 4.2rem); line-height: .95; letter-spacing: -.055em; }
  .playground-hero > div > p:last-child { max-width: 44rem; margin: 1rem 0 0; color: #c7d0c9; line-height: 1.65; }
  .hero-stats { display: grid; grid-template-columns: auto auto; align-content: center; gap: .1rem .65rem; min-width: 10rem; }
  .hero-stats strong { color: #b8f34a; font-size: 1.65rem; line-height: 1; text-align: right; }
  .hero-stats span { color: #c7d0c9; font-size: .72rem; }
  .lab-tabs { display: grid; grid-template-columns: repeat(4, 1fr); padding: 0 clamp(1rem, 4vw, 3rem); background: #10291f; border-top: 1px solid rgb(255 255 255 / 10%); }
  .lab-tabs button { display: flex; gap: .6rem; justify-content: center; padding: 1rem .6rem; color: #aeb9b2; background: transparent; border: 0; border-bottom: 3px solid transparent; font: inherit; font-size: .76rem; font-weight: 750; cursor: pointer; }
  .lab-tabs button span { color: #9aa79f; font-family: ui-monospace, monospace; }
  .lab-tabs button[aria-selected="true"] { color: white; border-bottom-color: #b8f34a; }
  .lab-tabs button[aria-selected="true"] span { color: #b8f34a; }
  main { padding: clamp(1.25rem, 4vw, 3rem); }
  [hidden] { display: none !important; }
  .lab-heading { margin-bottom: 1.5rem; }
  .lab-heading > p { color: #456a17; }
  .lab-heading h3 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.35rem); letter-spacing: -.04em; }
  .lab-heading > span { display: block; margin-top: .45rem; color: #65716a; line-height: 1.55; }
  .tool-grid, .roman-layout, .path-layout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  article, .roman-layout > div, .roman-layout > output, .path-layout > div, .path-layout > output, .member-layout { padding: 1.2rem; background: white; border: 1px solid #d9ded5; border-radius: .7rem; box-shadow: 0 12px 32px rgb(24 42 33 / 5%); }
  label { display: block; margin-bottom: .5rem; color: #536058; font-size: .7rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  input, textarea { width: 100%; padding: .78rem .85rem; color: #17211c; background: #f8faf5; border: 1px solid #bdc7bd; border-radius: .45rem; font: inherit; }
  textarea { resize: vertical; color: #b8f34a; background: #101713; font-family: ui-monospace, monospace; line-height: 1.45; }
  output { display: block; white-space: pre-wrap; }
  article output, #algorithm-members-output, #algorithm-path-output { min-height: 8rem; margin-top: .8rem; padding: 1rem; overflow-x: auto; color: #b8f34a; background: #101713; border-radius: .45rem; font-family: ui-monospace, monospace; font-size: .78rem; line-height: 1.5; }
  button { font: inherit; cursor: pointer; }
  .primary-action, .path-actions button { padding: .7rem .95rem; color: #13200d; background: #b8f34a; border: 1px solid #9cd02d; border-radius: .45rem; font-size: .74rem; font-weight: 850; }
  .member-layout { display: grid; gap: 1rem; }
  .member-flow { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; }
  .member-flow span { padding: .7rem .9rem; color: #214a37; background: #edf4ea; border-radius: .4rem; font-weight: 800; }
  .member-flow b { color: #718078; }
  .member-layout .primary-action { justify-self: start; }
  .roman-layout { align-items: stretch; }
  .examples { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .8rem; }
  .examples button, .path-actions button:last-child { padding: .48rem .68rem; color: #315b47; background: #edf4ea; border: 1px solid #cbd8c8; border-radius: .4rem; font-size: .72rem; font-weight: 800; }
  .roman-layout > output { display: grid; place-content: center; text-align: center; }
  .roman-layout output span { color: #718078; font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .roman-layout output strong { margin-top: .35rem; color: #315b47; font-family: Georgia, serif; font-size: clamp(2.7rem, 8vw, 5.5rem); letter-spacing: .06em; overflow-wrap: anywhere; }
  .path-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .8rem; }
  #algorithm-path-output { min-height: 100%; margin: 0; }
  code { padding: .1rem .25rem; color: #315b47; background: #e4eadf; border-radius: .2rem; }
  @media (max-width: 700px) {
    .playground-hero { display: block; }
    .hero-stats { margin-top: 1.5rem; justify-content: start; }
    .lab-tabs { grid-template-columns: repeat(2, 1fr); }
    .tool-grid, .roman-layout, .path-layout { grid-template-columns: 1fr; }
  }
</style>
